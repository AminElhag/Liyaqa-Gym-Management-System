# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=liyaqa_gym
DB_USERNAME=liyaqa_admin
DB_PASSWORD=liyaqa_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=liyaqa_redis_password
REDIS_DATABASE=0

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=liyaqa-gym-consumer-group

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JWT Configuration
JWT_SECRET=liyaqa-gym-secret-key-change-this-in-production-please-use-a-strong-random-key
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
JWT_ISSUER_URI=http://localhost:8080

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=*

# Admin Configuration
ADMIN_PASSWORD=admin123

# Gym Business Rules
MAX_MEMBERS_PER_CLASS=30
BOOKING_ADVANCE_DAYS=7
CANCELLATION_HOURS_BEFORE=2
